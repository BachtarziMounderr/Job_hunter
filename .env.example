# Local mode: no credentials needed. Relative paths resolve from the working directory.
DATABASE_URL=sqlite:///data/job_hunter.db
PROFILE_PATH=profiles/default.json
PROFILES_DIR=profiles/private
# For hosting, use the content of private/profiles.json as one secret JSON value.
PROFILES_JSON=
MIGRATION_DATABASE_URL=
ARBEITNOW_MAX_PAGES=1
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_ATTEMPTS=3
HTTP_RETRY_BASE_SECONDS=1
REQUEST_INTERVAL_SECONDS=1
LOG_LEVEL=INFO

# Real matching uses a local multilingual model. TF-IDF is an explicit lexical demo only.
EMBEDDING_BACKEND=sentence-transformer
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42
EMBEDDING_CPU_THREADS=2
EMBEDDING_BATCH_SIZE=16
MATCHING_MAX_JOBS=1000
JOB_MAX_AGE_DAYS=45
SCORE_WEIGHTS={"semantic":0.35,"skills":0.25,"experience":0.20,"education":0.10,"location":0.10}
ENABLE_JOBICY=true
JOBICY_MAX_PAGES=2

# Fill these locally. No Telegram account API ID/API hash is needed for outbound Bot API messages.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MINIMUM_MATCH_SCORE=65
MAX_NOTIFICATIONS_PER_DAY=10
NOTIFICATION_TIMEZONE=Africa/Algiers

# Use the endpoint associated with your Qwen provider/account/region, without /chat/completions.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
# Optional direct Qwen configuration, used only with LLM_PROVIDER=qwen.
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen-plus
LLM_ENABLED=false

# Cloud scheduler: keep disabled until profiles, database and secrets are configured.
PIPELINE_ENABLED=false
NOTIFICATIONS_ENABLED=false

# PostgreSQL later (install the postgres extra). Use your real URL only in .env.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
